<ol reversed class="postlist" style="counter-reset: start-from {{ (postslistCounter or postslist.length) + 1 }}">
{% for post in postslist | reverse %}
  {%- set postLang = post.data.lang or metadata.language %}
  {%- set versions = collections.all | translationsOf(post.data.translationKey) %}
  <li class="postlist-item{% if post.url == url %} postlist-item-active{% endif %}">
    <div>
      <a href="{{ post.url | url }}" class="postlist-link"{% if postLang != metadata.language %} lang="{{ postLang }}"{% endif %}>{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a>
      <div class="postlist-meta">
        <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
        {%- if versions.length > 1 %}
          <span class="lang-badges">
            {%- for v in versions %}{% set vl = v.data.lang or metadata.language %}<a href="{{ v.url | url }}" hreflang="{{ vl }}" title="{{ i18n.languages[vl].name }}">{{ i18n.languages[vl].short }}</a>{% endfor -%}
          </span>
        {%- elif postLang != metadata.language %}
          <span class="lang-badges"><span title="{{ i18n.languages[postLang].name }}">{{ i18n.languages[postLang].short }}</span></span>
        {%- endif %}
        {% for tag in post.data.tags | filterTagList %}
          {% set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
          <a href="{{ tagUrl | url }}" class="post-tag">{{ tag }}</a>
        {% endfor %}
      </div>
    </div>
  </li>
{% endfor %}
</ol>
