---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - post
    - posts
    - tagList
    - allMyContent
    - essays
    - endorsements
  addAllPagesToCollections: true
layout: layouts/home.njk
eleventyComputed:
  title: Tagged “{{ tag }}”
permalink: /tags/{{ tag | slugify }}/
---

<header class="page-header">
  <h1>tagged “{{ tag }}”</h1>
</header>
{% set postslist = collections[ tag ] | primaryOnly %}
{% include "postslist.njk" %}
<p>See
  <a href="{{ '/tags/' | url }}">all tags</a>.</p>
