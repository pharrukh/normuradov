{
  "name": "normuradov-blog",
  "version": "2.0.0",
  "description": "Personal Blog",
  "scripts": {
    "build": "npx @11ty/eleventy",
    "bench": "DEBUG=Eleventy:Benchmark* npx @11ty/eleventy",
    "watch": "npx @11ty/eleventy --watch",
    "serve": "npx @11ty/eleventy --serve",
    "start": "npx @11ty/eleventy --serve",
    "debug": "DEBUG=* npx @11ty/eleventy",
    "deploy": "rm -rf _site && npx @11ty/eleventy && npx -y firebase-tools@latest deploy --only hosting"
  },
  "author": {
    "name": "Farrukh Normuradov",
    "url": "https://www.normuradov.com/"
  },
  "license": "MIT",
  "homepage": "https://www.normuradov.com/",
  "dependencies": {
    "@11ty/eleventy": "^2.0.0",
    "@11ty/eleventy-img": "^2.0.1",
    "@11ty/eleventy-navigation": "^0.3.3",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^4.1.0",
    "luxon": "^2.4.0",
    "markdown-it": "^13.0.1",
    "markdown-it-anchor": "^8.6.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pharrukh/normuradov.git"
  }
}
